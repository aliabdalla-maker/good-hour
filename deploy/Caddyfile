# Caddy fetches and renews Let's Encrypt certificates automatically — no manual
# TLS setup. Requires ports 80+443 open and CNAME records for www.goodhour.shop
# and api.goodhour.shop pointing at this server. The apex is intentionally not
# used (CNAME-only DNS).
{
	# ACME contact address for certificate notices. Change to your email.
	email admin@goodhour.shop
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=()"
		-Server
		-X-Powered-By
	}
}

# Public web app (www subdomain — apex not used).
www.goodhour.shop {
	encode zstd gzip
	import security_headers
	header X-Frame-Options "SAMEORIGIN"
	reverse_proxy web:3000
}

# Public API (the browser calls this directly; it's NEXT_PUBLIC_API_URL).
api.goodhour.shop {
	encode zstd gzip
	import security_headers
	header X-Frame-Options "DENY"
	reverse_proxy api:4000
}

# Software Equality company website (static, from the softwareequality-website
# repo synced by the sitesync service). DNS: A records for softwareequality.com
# and www.softwareequality.com pointing at this server. Clean URLs like on
# Netlify: /privacy serves privacy.html.
softwareequality.com {
	encode zstd gzip
	import security_headers
	header X-Frame-Options "SAMEORIGIN"

	# The AI assistant (/api/chat) and bootcamp checkout still run as Netlify
	# Functions. Netlify routes by host name, so send them to Netlify's load
	# balancer as softwareequality.com. Temporary: replace with endpoints on
	# this server before the Netlify site is suspended or removed.
	@netlify path /api/* /.netlify/functions/*
	handle @netlify {
		reverse_proxy https://75.2.60.5 {
			header_up Host softwareequality.com
			transport http {
				tls_server_name softwareequality.com
			}
		}
	}

	handle {
		root * /srv/sites/softwareequality-website/site
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			root * /srv/sites/softwareequality-website/site
			rewrite * /404.html
			file_server
		}
	}
}

www.softwareequality.com {
	redir https://softwareequality.com{uri} permanent
}
