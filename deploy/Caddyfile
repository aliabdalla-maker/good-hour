# Caddy fetches and renews Let's Encrypt certificates automatically — no manual
# TLS setup. Requires ports 80+443 open and CNAME records for www.goodhour.shop
# and api.goodhour.shop pointing at this server. The apex is intentionally not
# used (CNAME-only DNS).
{
	email admin@goodhour.shop
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=()"
		-Server
		-X-Powered-By
	}
}

www.goodhour.shop {
	encode zstd gzip
	import security_headers
	header X-Frame-Options "SAMEORIGIN"
	reverse_proxy web:3000
}

api.goodhour.shop {
	encode zstd gzip
	import security_headers
	header X-Frame-Options "DENY"
	reverse_proxy api:4000
}

# Software Equality company website plus AEP-X.
# The company site is synced from softwareequality-website into /srv/sites.
# AEP-X is deployed independently by the aepx-core self-hosted GitHub runner
# into /srv/aepx/current and bind-mounted read-only into this container.
softwareequality.com {
	encode zstd gzip
	import security_headers
	header X-Frame-Options "SAMEORIGIN"

	# Canonicalise the application root.
	redir /aep-x /aep-x/ 308

	# AEP-X static application. handle_path strips /aep-x before file lookup,
	# while the SPA fallback keeps future client-side routes working.
	handle_path /aep-x/* {
		root * /srv/aepx/current
		try_files {path} {path}/ /index.html
		header Cache-Control "no-cache"
		file_server
	}

	# AI assistant (/api/chat) and bootcamp checkout for the company website.
	@api path /api/* /.netlify/functions/*
	handle @api {
		reverse_proxy se-api:8787
	}

	handle {
		root * /srv/sites/softwareequality-website/site
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			root * /srv/sites/softwareequality-website/site
			rewrite * /404.html
			file_server
		}
	}
}

www.softwareequality.com {
	redir https://softwareequality.com{uri} permanent
}
