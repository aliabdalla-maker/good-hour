# Caddy fetches and renews Let's Encrypt certificates automatically for both
# hostnames — no manual TLS setup. Requires: ports 80+443 open, and DNS A/AAAA
# records for goodhour.shop AND api.goodhour.shop pointing at this server.
{
	# ACME contact address for certificate notices. Change to your email.
	email admin@goodhour.shop
}

# Public web app.
goodhour.shop, www.goodhour.shop {
	encode zstd gzip
	reverse_proxy web:3000
}

# Public API (the browser calls this directly; it's NEXT_PUBLIC_API_URL).
api.goodhour.shop {
	encode zstd gzip
	reverse_proxy api:4000
}
