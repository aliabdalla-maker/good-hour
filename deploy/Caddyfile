# Caddy fetches and renews Let's Encrypt certificates automatically — no manual
# TLS setup. Requires ports 80+443 open and CNAME records for www.goodhour.shop
# and api.goodhour.shop pointing at this server. The apex is intentionally not
# used (CNAME-only DNS).
{
	# ACME contact address for certificate notices. Change to your email.
	email admin@goodhour.shop
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=()"
		-Server
		-X-Powered-By
	}
}

# Public web app (www subdomain — apex not used).
www.goodhour.shop {
	encode zstd gzip
	import security_headers
	header X-Frame-Options "SAMEORIGIN"
	reverse_proxy web:3000
}

# Public API (the browser calls this directly; it's NEXT_PUBLIC_API_URL).
api.goodhour.shop {
	encode zstd gzip
	import security_headers
	header X-Frame-Options "DENY"
	reverse_proxy api:4000
}

# Software Equality company website (static, from the softwareequality-website
# repo synced by the sitesync service). DNS: A records for softwareequality.com
# and www.softwareequality.com pointing at this server. Clean URLs like on
# Netlify: /privacy serves privacy.html.
softwareequality.com {
	encode zstd gzip
	import security_headers
	header X-Frame-Options "SAMEORIGIN"

	# Content Security Policy. The pages use inline scripts, inline styles and
	# a few onclick handlers, so 'unsafe-inline' is still needed; everything
	# else is locked to this site plus the contact form (Web3Forms) and an
	# optional booking calendar iframe on /book.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; frame-src https://calendar.google.com https://cal.com https://calendly.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

	# Old .html links: 301 to the clean URL (/privacy.html -> /privacy,
	# /index.html and /about/index.html -> the folder). Caddy runs redir
	# before the handle blocks, so this sees the original request path.
	@indexhtml path_regexp idx ^(.*/)index\.html$
	@html path_regexp page ^(.+)\.html$
	redir @indexhtml {re.idx.1}{?query} permanent
	redir @html {re.page.1}{?query} permanent

	# Caching: fonts never change (1 year); images keep their names when
	# replaced, so 30 days; CSS and JS are loaded with ?v= version strings, so
	# a day is safe; HTML is always revalidated.
	@fonts path /fonts/* *.woff2
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@images path *.png *.jpg *.jpeg *.webp *.svg *.ico
	header @images Cache-Control "public, max-age=2592000"
	@assets path *.css *.js
	header @assets Cache-Control "public, max-age=86400"
	@pages not path /fonts/* *.woff2 *.png *.jpg *.jpeg *.webp *.svg *.ico *.css *.js /api/* /.netlify/functions/*
	header @pages Cache-Control "no-cache"

	# AI assistant (/api/chat) and bootcamp checkout: served by the se-api
	# service on this server (code in the softwareequality-website repo,
	# api/server.mjs). The legacy Netlify Functions path is kept so existing
	# pages keep working unchanged.
	@api path /api/* /.netlify/functions/*
	handle @api {
		reverse_proxy se-api:8787
	}

	handle {
		root * /srv/sites/softwareequality-website/site
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			root * /srv/sites/softwareequality-website/site
			rewrite * /404.html
			file_server
		}
	}
}

www.softwareequality.com {
	redir https://softwareequality.com{uri} permanent
}
