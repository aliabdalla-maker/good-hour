{
  "name": "gihtcx",
  "private": true,
  "version": "0.0.1",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "node --import tsx --test \"packages/**/src/**/*.test.ts\" \"packages/web/lib/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"packages/**/src/**/*.test.ts\" \"packages/web/lib/**/*.test.ts\"",
    "docs:tokens": "node --import tsx scripts/gen-design-tokens.mjs",
    "test:integration": "node --import tsx --test \"packages/**/src/**/*.itest.ts\"",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:deploy": "npm run deploy --workspace=packages/db",
    "db:drift": "npm run drift --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=22"
  }
}
