# --- Database ---
# Host ports 5433/6380 map to the containers' 5432/6379 (see docker-compose.yml)
# to avoid clashing with any native Postgres/Redis already on the standard ports.
DATABASE_URL="postgresql://gihtcx:gihtcx_dev_password@localhost:5433/gihtcx?schema=public"

# --- Redis / Queue ---
REDIS_URL="redis://localhost:6380"

# --- Auth ---
JWT_SECRET="dev-only-change-me-to-a-long-random-string"
COOKIE_NAME="gihtcx_session"

# --- OpenAI (required for pricing-agent and negotiation-agent) ---
# Get a key: https://platform.openai.com/api-keys  (starts with sk-...)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Gemini / "Nano Banana" (optional; powers AI-generated listing photos) ---
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# --- Smoobu (optional; imports the connected account's properties as sourcing drafts) ---
# Settings -> Advanced -> API Keys in your Smoobu account. The secret is shown
# only once at creation.
SMOOBU_API_KEY=""
SMOOBU_API_SECRET=""

# --- Stripe (test mode) ---
# Get test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""            # sk_test_...
STRIPE_WEBHOOK_SECRET=""        # whsec_... (from `stripe listen` or the dashboard)
# The browser's *publishable* key (pk_test_...) goes in packages/web/.env.local
# as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY — the API does not read it.

# --- Communication channels (all optional; console-logged if unset) ---
# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Good Hours <onboarding@resend.dev>"
# SMS (Twilio) — all three required to enable the SMS channel
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- App ---
API_PORT=4000
WEB_PUBLIC_API_URL="http://localhost:4000"
NODE_ENV="development"
# Comma-separated browser origins allowed to make credentialed API calls (CORS).
WEB_ORIGIN="http://localhost:3000"
# Public base URL of the API (used to build unsubscribe links in emails).
API_PUBLIC_URL="http://localhost:4000"
# Minutes an unpaid booking holds its slots before they auto-release.
RESERVATION_HOLD_MINUTES=15
