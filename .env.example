# --- Database ---
# Host ports 5433/6380 map to the containers' 5432/6379 (see docker-compose.yml)
# to avoid clashing with any native Postgres/Redis already on the standard ports.
DATABASE_URL="postgresql://gihtcx:gihtcx_dev_password@localhost:5433/gihtcx?schema=public"

# --- Redis / Queue ---
REDIS_URL="redis://localhost:6380"

# --- Auth ---
JWT_SECRET="dev-only-change-me-to-a-long-random-string"
COOKIE_NAME="gihtcx_session"

# --- OpenAI (required for pricing-agent and negotiation-agent) ---
OPENAI_API_KEY="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"
OPENAI_MODEL="gpt-4o-mini"

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY="sk_test_51TwicZFu71fGoQLZ2iYPbvtavvHbG6X2sYOmindg3qrWDAGIjIRcIHkdj6QslArc4m8Z9mPZzWGAEKbpMbOiPaHt00YaKFBcJk"
STRIPE_PUBLISHABLE_KEY="rk_test_51Tg3n02elwFS3I7LicPdomHzQ1hJGra7JyCgw1sda29rjFZnuuHtsCGtHX9js0Ol8Ar7EF9NfUQQNlVe5xw9guYi006b9yavRy"
