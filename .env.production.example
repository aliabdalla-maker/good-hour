# =========================================================================
# PRODUCTION env for goodhour.shop. On the server: copy to `.env`, fill in,
# then `docker compose -f docker-compose.prod.yml up -d --build`.
# NEVER commit the filled-in .env. Rotate any secret that has been shared.
# =========================================================================

# --- Postgres (used by the postgres container AND DATABASE_URL below) ---
POSTGRES_USER="gihtcx"
POSTGRES_PASSWORD="CHANGE_ME_long_random_password"
POSTGRES_DB="gihtcx"
# Host is the compose service name "postgres"; keep user/pass/db in sync above.
DATABASE_URL="postgresql://gihtcx:CHANGE_ME_long_random_password@postgres:5432/gihtcx?schema=public"

# --- Redis (compose service name "redis") ---
REDIS_URL="redis://redis:6379"

# --- Auth ---
# Generate: `openssl rand -hex 32`
JWT_SECRET="CHANGE_ME_generate_a_64_char_hex_string"
COOKIE_NAME="gihtcx_session"

# --- Runtime / URLs ---
NODE_ENV="production"
# CORS allow-list (comma-separated). Primary web host is the www subdomain
# (apex is not used — keeps DNS to CNAMEs only).
WEB_ORIGIN="https://www.goodhour.shop"
# Public API base — used for email unsubscribe links.
API_PUBLIC_URL="https://api.goodhour.shop"
RESERVATION_HOLD_MINUTES=15

# --- Web build-time public vars (baked into the browser bundle) ---
NEXT_PUBLIC_API_URL="https://api.goodhour.shop"
# MUST be a *publishable* key (pk_live_… or pk_test_…), never sk_/rk_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# --- OpenAI ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Stripe (live mode for real payments) ---
STRIPE_SECRET_KEY=""            # sk_live_...
STRIPE_WEBHOOK_SECRET=""        # whsec_... from the Dashboard webhook for https://api.goodhour.shop

# --- Email (Resend) ---
RESEND_API_KEY=""               # re_...
# Use a verified sending domain in production, e.g. no-reply@goodhour.shop
EMAIL_FROM="Good Hours <no-reply@goodhour.shop>"

# --- SMS (Twilio) — all three required to enable SMS ---
TWILIO_ACCOUNT_SID=""           # AC... (Account SID, not a VA… Verify SID)
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""           # +1...
